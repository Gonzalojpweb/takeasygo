{
  "name": "takeasygo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:saas": "turbo dev --filter=@takeasygo/saas",
    "dev:pos": "turbo dev --filter=@takeasygo/pos",
    "build": "turbo build",
    "build:saas": "turbo build --filter=@takeasygo/saas",
    "build:pos": "turbo build --filter=@takeasygo/pos",
    "start": "NODE_OPTIONS=--openssl-legacy-provider node dist/index.js",
    "lint": "turbo lint --filter=@takeasygo/saas",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "proxy-addr": "^2.0.8",
      "sharp@<0.35.5": "0.35.5",
      "dompurify@<3.4.17": "3.4.17",
      "body-parser@<1.20.9": "1.20.9",
      "engine.io@<6.6.11": "6.6.11",
      "socket.io-parser@<4.2.7": "4.2.7",
      "lodash@<4.18.0": "^4.18.0",
      "tmp@<0.2.6": "^0.2.6"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.22.4",
    "turbo": "^2.9.14",
    "typescript": "^5"
  }
}
