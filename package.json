{
  "name": "takeasygo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:saas": "turbo dev --filter=@takeasygo/saas",
    "dev:pos": "turbo dev --filter=@takeasygo/pos",
    "build": "turbo build",
    "build:saas": "turbo build --filter=@takeasygo/saas",
    "build:pos": "turbo build --filter=@takeasygo/pos",
    "start": "NODE_OPTIONS=--openssl-legacy-provider node dist/index.js",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.22.4",
    "turbo": "^2.9.14",
    "typescript": "^5"
  }
}
