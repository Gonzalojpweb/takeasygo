{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "MONGODB_URI",
        "AUTH_SECRET",
        "ENCRYPTION_KEY",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "POSTHOG_SERVER_KEY",
        "POSTHOG_PROJECT_ID",
        "API_URL",
        "SSO_JWT_PUBLIC_KEY",
        "DELIVERY_SIMULATE_GPS",
        "KRIPTON_API_URL",
        "WHAPI_TOKEN",
        "GOOGLE_WALLET_SERVICE_ACCOUNT_KEY",
        "GOOGLE_WALLET_ISSUER_ID",
        "WALLET_WEB_SERVICE_SECRET",
        "CRON_SECRET",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "AUTH_URL",
        "CLOUDINARY_API_SECRET",
        "AUTH_TRUST_HOST",
        "ADMIN_EMAIL",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VITE_SYNC_URL",
        "VITE_SAAS_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
